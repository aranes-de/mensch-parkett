---
title: "Leistungen Christian Mensch Parkett- und Fußbodentechnik, Laaberstraße 3, 93059 Regensburg"
description: "Unsere Leistung beginnt bei Ihrer Beratung und für Sie nehmen wir uns besonders gerne Zeit."
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}/">
  <meta name="theme-color" content="#0a1a33">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="de_DE">
  <meta property="og:title" content="Christian Mensch – Parkett- und Fußbodentechnik">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="{{ site.url }}/images/og.jpg">
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="preload" as="image" href="/images/hero/hero-a-m.webp" media="(max-width: 760px)" fetchpriority="high">
  <link rel="preload" as="image" imagesrcset="/images/hero/hero-a-1200.webp 1200w, /images/hero/hero-a-1800.webp 1800w, /images/hero/hero-a-2560.webp 2560w" imagesizes="100vw" media="(min-width: 761px)" fetchpriority="high">
  <style>{% inlineCss "src/css/style.css" %}</style>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "HomeAndConstructionBusiness",
    "name": "Christian Mensch Parkett- und Fußbodentechnik",
    "url": "{{ site.url }}/",
    "image": "{{ site.url }}/images/og.jpg",
    "telephone": "{{ site.phone }}",
    "email": "{{ site.email }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Laaberstraße 3",
      "postalCode": "93059",
      "addressLocality": "Regensburg",
      "addressCountry": "DE"
    }
  }
  </script>
</head>
<body>

<svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">{% inlineFile "src/_includes/logo-symbol.svg" %}</svg>

<a class="skip" href="#inhalt">Zum Inhalt springen</a>

<!-- ============ HEADER ============ -->
<header class="hdr" data-hdr>
  <div class="hdr__in">
    <a href="/" class="hdr__logo" aria-label="Christian Mensch – Startseite">
      <svg viewBox="0 0 867.311 270.957" aria-hidden="true" focusable="false"><use href="#logo"/></svg>
    </a>
    <nav class="hdr__nav" aria-label="Hauptnavigation">
      <a href="/#leistungen" aria-current="page">Leistungen</a>
      <a href="/">Produkte</a>
      <a href="/">Unternehmen</a>
      <a href="/">Ausstellung</a>
      <a href="/#kontakt">Kontakt</a>
    </nav>
    <a href="tel:{{ site.phone }}" class="btn btn--blue btn--sm btn--icon hdr__tel" aria-label="Anrufen: {{ site.phoneLabel }}">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
      <span>{{ site.phoneLabel }}</span>
    </a>
    <button class="hdr__burger" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mnav" data-burger><span></span><span></span><span></span></button>
  </div>
</header>

<div class="mnav" id="mnav" data-mnav hidden>
  <nav aria-label="Mobile Navigation">
    <a href="/#leistungen">Leistungen</a>
    <a href="/">Produkte</a>
    <a href="/">Unternehmen</a>
    <a href="/">Ausstellung</a>
    <a href="/#kontakt">Kontakt</a>
  </nav>
  <div class="mnav__foot">
    <a href="tel:{{ site.phone }}">{{ site.phoneLabel }}</a>
    <a href="mailto:{{ site.email }}">{{ site.email }}</a>
  </div>
</div>

<main id="inhalt">

<!-- ============ HERO ============ -->
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <picture>
      <source media="(max-width: 760px)" srcset="/images/hero/hero-a-m.webp">
      <img class="hero__img" src="/images/hero/hero-a-1800.webp" srcset="/images/hero/hero-a-1200.webp 1200w, /images/hero/hero-a-1800.webp 1800w, /images/hero/hero-a-2560.webp 2560w" sizes="100vw" alt="" width="2560" height="1429" fetchpriority="high" decoding="async">
    </picture>
    <picture>
      <source media="(max-width: 760px)" data-srcset="/images/hero/hero-b-m.webp">
      <img class="hero__img hero__img--b" data-src="/images/hero/hero-b-1800.webp" data-srcset="/images/hero/hero-b-1200.webp 1200w, /images/hero/hero-b-1800.webp 1800w, /images/hero/hero-b-2560.webp 2560w" sizes="100vw" alt="" width="2560" height="1429" decoding="async" data-defer>
    </picture>
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="wrap hero__in">
    <p class="hero__kicker"><span class="line-mask"><span>Christian Mensch · Parkett- und Fußbodentechnik</span></span></p>
    <h1 class="hero__title" id="hero-title">
      <span class="line-mask"><span>Parkett-Verlege-</span></span>
      <span class="line-mask"><span>Meisterfachbetrieb</span></span>
      <span class="line-mask"><span><em>in Parkett und Raumausstatter</em></span></span>
    </h1>
    <div class="hero__actions">
      <a href="tel:{{ site.phone }}" class="btn btn--green btn--icon"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg><span>{{ site.phoneLabel }}</span></a>
      <a href="#imagefilm" class="hero__film">
        <span class="hero__film-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z"/></svg></span>
        <span>Unser Imagefilm</span>
      </a>
    </div>
  </div>

  <div class="hero__progress" aria-hidden="true">
    <span class="hero__count"><b>01</b><i>02</i></span>
    <span class="hero__bars"><span></span><span></span></span>
  </div>

  <a href="#leistungen" class="hero__scroll" aria-label="Zu den Leistungen scrollen"><span></span></a>
</section>

<!-- ============ LEISTUNGEN ============ -->
<section class="services" id="leistungen" aria-labelledby="leistungen-title">
  <div class="wrap">
    <header class="services__head">
      <h2 class="h-xl" id="leistungen-title" data-reveal>Leistungen</h2>
      <ol class="steps" data-steps>
        <li><a href="#beratung"><span>01</span>Beratung</a></li>
        <li><a href="#planung"><span>02</span>Planung</a></li>
        <li><a href="#umsetzung"><span>03</span>Umsetzung</a></li>
        <li><a href="#ansprechpartner"><span>04</span>Verlässlicher Ansprechpartner</a></li>
      </ol>
    </header>

    {% set leistungen = [
      { id: "beratung", no: "01", title: "Beratung", img: "img_1_d", alt: "Holzmuster-Fächer bei der Parkettberatung",
        text: "Unsere Leistung beginnt bei Ihrer Beratung und für Sie nehmen wir uns besonders gerne Zeit. Ihr Zuhause ist so individuell wie Sie. Deshalb startet unsere punktgenaue Beratung zum Thema Parkett und Bodenbelag auch mit Ihren Wünschen und Bedürfnissen. Durch unsere jahrelange Expertise können wir Ihnen direkt und schnell weiterhelfen und den ersten Schritt zu Ihrem perfekten Parkettboden legen." },
      { id: "planung", no: "02", title: "Planung", img: "img_2_d", alt: "Raumskizze, die in ein fertig eingerichtetes Wohnzimmer mit Fischgrätparkett übergeht",
        text: "Nur durch eine optimale Planung gelingt Ihr Vorhaben optimal und ohne Ärgernisse. Dabei gehen wir zielgerichtet auf Ihre Bedürfnisse und den baulichen Gegebenheiten ein. Durch unsere dauerhafte Ausstellung von verschiedenen Arten Bodenbelag und Hölzern können Sie sich schon hier einen umfangreichen Eindruck vom fertig verlegten Boden machen. So können wir Ihnen ein rundherum gelungenes Ergebnis gewährleisten." },
      { id: "umsetzung", no: "03", title: "Umsetzung", img: "img_3_d", alt: "Parkettdiele wird beim Verlegen eingesetzt",
        text: "Eine perfekte Umsetzung ist für uns das absolute A und O. Schließlich möchten Sie genau das: Einen perfekt verlegten Boden - in Ihrem Zuhause - genießen. Durch unsere jahrzehntelange Erfahrung und der Expertise als Obermeister der Innung für Parkett- und Fußbodentechnik Niederbayern und Oberpfalz setzen wir selbst anspruchsvolle Projekte um. Dabei achten wir besonders auf die Verbauung und den Einsatz von hochwertigem und regionalem Material. Der verantwortungsvolle Umgang mit Ressourcen liegt uns dabei besonders am Herzen." },
      { id: "ansprechpartner", no: "04", title: "Verlässlicher Ansprechpartner", img: "img_bild4_d", alt: "Christian Mensch und seine Frau in der Ausstellung",
        text: "Auch nach dem Verlegen des Bodens sind wir Ihr verlässlicher Ansprechpartner. Gerne geben wir Ihnen Tipps, wie Sie Ihren künftigen Boden pflegen und wie Sie Schäden vermeiden. Im Fall der Fälle helfen wir Ihnen direkt und unkompliziert bei der Wiederinstandsetzung. Für uns stehen eben Sie und Ihre Zufriedenheit im Mittelpunkt." }
    ] %}

    <div class="svc-list">
      {% for l in leistungen %}
      <article class="svc{% if loop.index is even %} svc--flip{% endif %}" id="{{ l.id }}" data-reveal>
        <div class="svc__media">
          <div class="planks" data-planks>
            <img src="/images/leistungen/{{ l.img }}.webp" alt="{{ l.alt }}" width="633" height="312" loading="lazy" decoding="async">
            <span></span><span></span><span></span><span></span><span></span>
          </div>
        </div>
        <div class="svc__body">
          <span class="svc__no" aria-hidden="true">{{ l.no }}</span>
          <h3 class="h-lg">{{ l.title }}</h3>
          <p>{{ l.text }}</p>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ============ IMAGEFILM ============ -->
<section class="film" id="imagefilm" aria-labelledby="film-title">
  <div class="wrap">
    <h2 class="h-xl film__title" id="film-title" data-reveal>Unser <em>Imagefilm</em></h2>
    <div class="film__player" data-yt="{{ site.youtubeId }}" data-reveal>
      <img src="/images/imagefilm-1280.webp" srcset="/images/imagefilm-640.webp 640w, /images/imagefilm-1280.webp 1280w" sizes="(max-width: 1240px) 100vw, 1200px" alt="" width="1280" height="720" loading="lazy" decoding="async">
      <button class="film__play" type="button" aria-label="Imagefilm abspielen (lädt YouTube)">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5.5v13l11-6.5z"/></svg>
      </button>
    </div>
  </div>
</section>

<!-- ============ KONTAKT / CTA ============ -->
<section class="cta" id="kontakt" aria-labelledby="cta-title">
  <div class="wrap cta__grid">
    <div class="cta__text" data-reveal>
      <h2 class="h-xl" id="cta-title">Sie haben <em>Fragen?</em></h2>
      <p class="cta__lead">Vereinbaren Sie jetzt einen Beratungstermin.</p>
      <div class="cta__actions">
        <a href="tel:{{ site.phone }}" class="btn btn--blue btn--icon"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg><span>{{ site.phoneLabel }}</span></a>
        <a href="mailto:{{ site.email }}" class="btn btn--line btn--icon"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.4V17h16V7.4l-8 5.6-8-5.6zM5.6 7l6.4 4.5L18.4 7H5.6z"/></svg><span>E-Mail schreiben</span></a>
      </div>
    </div>
    <address class="card" data-reveal>
      <p class="card__name">Me. Christian Mensch</p>
      <p>Parkett- und Fußbodentechnik</p>
      <p>Laaberstraße 3<br>93059 Regensburg</p>
      <p class="card__row"><span>Tel:</span> <a href="tel:{{ site.phone }}">{{ site.phoneLabel }}</a></p>
      <p class="card__row"><span>E-Mail:</span> <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    </address>
  </div>
</section>

</main>

<!-- ============ FOOTER ============ -->
<footer class="ftr">
  <div class="wrap">
    <div class="ftr__top">
      <a href="/" class="ftr__logo" aria-label="Christian Mensch – Startseite">
        <svg viewBox="0 0 867.311 270.957" aria-hidden="true" focusable="false"><use href="#logo"/></svg>
      </a>
      <nav class="ftr__nav" aria-label="Footer-Navigation">
        <a href="/#leistungen">Leistungen</a>
        <a href="/">Produkte</a>
        <a href="/">Unternehmen</a>
        <a href="/">Ausstellung</a>
        <a href="/#kontakt">Kontakt</a>
      </nav>
    </div>
    <div class="ftr__bottom">
      <div class="ftr__legal">
        <a href="/">Impressum</a>
        <a href="/">Datenschutz</a>
        <a href="/">Sitemap</a>
      </div>
      <a href="https://www.aranes.de" class="ftr__credit">Webdesign by ARANES</a>
    </div>
  </div>
</footer>

<script>{% inlineJs "src/js/main.js" %}</script>
</body>
</html>
